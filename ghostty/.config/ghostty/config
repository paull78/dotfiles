# Ghostty Configuration
# Hide titlebar but keep traffic lights and rounded corners
macos-titlebar-style = hidden

# Optional: Add some padding for better appearance
window-padding-x = 10
window-padding-y = 10

# Subtle translucency. 1.0 = fully opaque, lower = more see-through.
background-opacity = 0.95
background-blur-radius = 20

# Auto-install Ghostty's terminfo on remote hosts over SSH and propagate TERM,
# so apps like mc/htop/vim get colors and arrow keys on the remote.
shell-integration-features = ssh-env,ssh-terminfo

# Color theme — imported from iTerm2 "Default" profile (Solarized Dark).
background = 002b36
foreground = 839496
cursor-color = 839496
cursor-text = 073642
selection-background = 073642
selection-foreground = 93a1a1


<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.paolo.sketchybar.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/paolo/.config/sketchybar/helpers/watchdog.sh</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/sketchybar_watchdog_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sketchybar_watchdog_stderr.log</string>
</dict>
</plist>
